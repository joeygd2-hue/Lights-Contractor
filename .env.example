# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local for local development. In production, set these in your
# hosting provider's environment settings (e.g. Vercel → Project → Settings →
# Environment Variables). Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site, no trailing slash. Used for canonical URLs, sitemap,
# Open Graph and links in emails.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS, …).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Optional: max connections per server instance (default 5).
# DATABASE_POOL_MAX=5
# Optional: set to "false" only for databases without TLS.
# DATABASE_SSL=true

# Long random string (32+ chars). Used to hash IP addresses for rate limiting.
# Generate one: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# ── Owner dashboard (/admin) ─────────────────────────────────────────────────
ADMIN_EMAIL=you@your-domain.com
# Generate with: npm run admin:hash -- "a long unique password"
ADMIN_PASSWORD_HASH=scrypt:replace:me

# ── Email (Resend — https://resend.com) ──────────────────────────────────────
# Leave blank to disable email. Leads and bookings are still saved and shown
# in the dashboard; the dashboard shows a warning while email is off.
RESEND_API_KEY=
# Must be on a domain you've verified in Resend, e.g. "Sugar Land Lighting Solutions <hello@your-domain.com>"
EMAIL_FROM=
# Where new-lead and new-booking notifications go.
OWNER_NOTIFICATION_EMAIL=
